rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /docs/{allPaths=**} {
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType == 'application/pdf';
    }
  }
}
